PORT=4000
ALLOW_ORIGIN=http://localhost:3010

SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=CEO_REPORT
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_SERVER_CERT=true
SQL_SERVER_SCHEMA=dbo
SQL_SERVER_PLAN_TABLE=production_planDev
SQL_SERVER_HISTORY_TABLE=production_plan_historyDev
# Employee master (ZHR_EMPLOYEE) on the same SQL_SERVER_HOST
SQL_SERVER_INFO_DATABASE=INFO

# Access log SQL Server (tbl_access_log on a separate host)
SQL_ACCESS_LOG_HOST=
SQL_ACCESS_LOG_PORT=1433
SQL_ACCESS_LOG_DATABASE=
SQL_ACCESS_LOG_USER=
SQL_ACCESS_LOG_PASSWORD=
SQL_ACCESS_LOG_ENCRYPT=false
SQL_ACCESS_LOG_TRUST_SERVER_CERT=true
SQL_ACCESS_LOG_SCHEMA=dbo
SQL_ACCESS_LOG_TABLE=tbl_access_log

# Downtime SQL Server
SQL_DOWNTIME_HOST=
SQL_DOWNTIME_PORT=1433
SQL_DOWNTIME_DATABASE=Downtime
SQL_DOWNTIME_USER=
SQL_DOWNTIME_PASSWORD=
SQL_DOWNTIME_ENCRYPT=false
SQL_DOWNTIME_TRUST_SERVER_CERT=true
SQL_DOWNTIME_SCHEMA=dbo
SQL_DOWNTIME_TABLE=Downtimes

# RM weight source SQL Servers (one per plant, for real Yield calculation)
SQL_RM_RMD7_HOST=
SQL_RM_RMD7_PORT=1433
SQL_RM_RMD7_DATABASE=
SQL_RM_RMD7_USER=
SQL_RM_RMD7_PASSWORD=
SQL_RM_RMD7_ENCRYPT=false
SQL_RM_RMD7_TRUST_SERVER_CERT=true

SQL_RM_RMD8_HOST=
SQL_RM_RMD8_PORT=1433
SQL_RM_RMD8_DATABASE=
SQL_RM_RMD8_USER=
SQL_RM_RMD8_PASSWORD=
SQL_RM_RMD8_ENCRYPT=false
SQL_RM_RMD8_TRUST_SERVER_CERT=true

SQL_RM_MSM_HOST=
SQL_RM_MSM_PORT=1433
SQL_RM_MSM_DATABASE=
SQL_RM_MSM_USER=
SQL_RM_MSM_PASSWORD=
SQL_RM_MSM_ENCRYPT=false
SQL_RM_MSM_TRUST_SERVER_CERT=true

# Downtime "center" source (separate machine - the real, currently-updated downtime log;
# the central Downtime DB above has stopped receiving RMD7/RMD8/MSM rows since ~Apr/May 2026)
SQL_DOWNTIME_SRC_HOST=
SQL_DOWNTIME_SRC_PORT=1433
SQL_DOWNTIME_SRC_DATABASE=
SQL_DOWNTIME_SRC_USER=
SQL_DOWNTIME_SRC_PASSWORD=
SQL_DOWNTIME_SRC_ENCRYPT=false
SQL_DOWNTIME_SRC_TRUST_SERVER_CERT=true

# Hosts allowed to reach the dev server over the LAN (comma-separated, wildcards ok)
ALLOWED_DEV_ORIGINS=
